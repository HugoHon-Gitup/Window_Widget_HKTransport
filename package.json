{
  "name": "hk-transport-widget",
  "version": "1.0.0",
  "description": "Hong Kong Public Transport Desktop Widget for Windows",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "node launcher.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate-icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "dist": "npm run build && electron-builder --win",
    "pack": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.easyboard.hktransportwidget",
    "productName": "EasyBoard",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^2.1.8"
  }
}
